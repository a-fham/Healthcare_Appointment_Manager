# Copy to .env and fill in. Never commit .env , names only live here.

PORT=3000
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/hcm_dev
JWT_SECRET=change-me-to-a-long-random-string
JOB_SECRET=change-me-too-shared-with-the-tick-caller
COOKIE_NAME=hcm_session
HOLD_MINUTES=5

# Email delivery. Omit SMTP_HOST to run in dev mode (emails are logged, not sent).
EMAIL_FROM=clinic@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google Calendar sync (optional; omit GOOGLE_REFRESH_TOKEN to skip calendar writes).
# Setup steps: docs/03-setup-and-run.md §Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# LLM summaries: none = deterministic fallback rubric (runs keyless).
# openai | gemini switch providers via native fetch.
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Background scheduler inside the server process.
CRON_ENABLED=true
