# ---- Required -----------------------------------------------------------
# Postgres connection string. Local dev example below; on Render/Neon use
# the pooled connection string from your Neon dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hcm_dev

# Long random string (openssl rand -hex 32). Signs the session cookie.
JWT_SECRET=replace-with-long-random-string

# Shared secret required in the x-job-secret header of POST /api/jobs/tick.
JOB_SECRET=replace-with-another-random-string

# ---- Optional (defaults shown) ------------------------------------------
PORT=3000
COOKIE_NAME=hcm_session
HOLD_MINUTES=5
CRON_ENABLED=true

# ---- Email (R9). Unset SMTP_HOST = console transport (dev) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Google Calendar (R10b). Any unset value => calendar marked skipped --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ---- LLM (R6/R7/R12): none | openai | gemini ----------------------------
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
